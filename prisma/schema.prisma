model StartupInfo {
  id Int @id @default(autoincrement())
  userId Int @unique
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  foundedYear Int?
  industry IndustryType?
  technologies TechnologyType[]

  pitchDeck String?
  demoVideo String?

  monthlyUsersAverage Int?
  revenue Int?

  teamSize Int?
  members Member[]

  visible Boolean @default(false)

  contactEmail String?

  github String?
  instagram String?
  linkedin String?
  facebook String?
}

enum CompanyType {
  VENTURE_CAPITAL       // Fondo de inversión
  ANGEL_INVESTOR        // Inversor ángel
  ACCELERATOR           // Aceleradora/Incubadora
  CORPORATION           // Empresa/Corporación
  STARTUP               // Otra start-up
  GOVERNMENT            // Gobierno/Institución
  OTHER                 // Otro
}

enum Plan {
  PRO
  BASIC
  FREE
}

enum PlanStatus {
  ACTIVE
  INACTIVE
}

model CompanyInfo {
  id Int @id @default(autoincrement())
  userId Int @unique
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  industry IndustryType?
  size Int?
  companyType CompanyType?
  website String?

  plan Plan
  planStatus PlanStatus
}

enum PositionType {
  CEO
  CO_FOUNDER

  UX_DESIGNER
  UI_DESIGNER
  PRODUCT_DESIGNER
  PRODUCT_MANAGER

  SOFTWARE_ENGINEER
  FRONTEND_DEVELOPER
  BACKEND_DEVELOPER
  FULLSTACK_DEVELOPER
  MOBILE_DEVELOPER
  DEVOPS_ENGINEER
  DATA_ENGINEER
  ML_ENGINEER
  SECURITY_ENGINEER
  DATA_SCIENTIST

  MARKETING_MANAGER
  SALES_MANAGER
  CONTENT_MANAGER

  OTHER

}

model Member {
  id Int @id @default(autoincrement())
  startupInfoId Int
  name String
  age Int
  position PositionType

  profileImage String?
  university String?

  startup StartupInfo @relation(fields: [startupInfoId], references: [id], onDelete: Cascade)
}
