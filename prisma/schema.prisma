generator client {
  provider = "prisma-client"
  output = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STARTUP
  COMPANY
  ADMIN
}

model User {
  id Int @id @default(autoincrement())
  email String @unique
  password String
  role UserRole

  name String @unique
  description String?
  logo String?
  webiste String?
  
  createdAt DateTime @default(now())
  updateAt DateTime @updatedAt

  startupInfo StartupInfo?
  companyInfo CompanyInfo?
}

