enum Plan {
  FREE
  BASIC
  PRO
}

enum PlanStatus {
  ACTIVE
  INACTIVE
  CANCELLED
}

enum CompanyType {
  VENTURE_CAPITAL // Fondo de inversión
  ANGEL_INVESTOR // Inversor ángel
  ACCELERATOR // Aceleradora/Incubadora
  CORPORATION // Empresa/Corporación
  STARTUP // Otra start-up
  GOVERNMENT // Gobierno/Institución
  OTHER // Otro
}

model User {
  id          Int          @id @default(autoincrement())
  email       String       @unique
  password    String
  role        Role
  name        String?
  description String?
  logo        String?
  website     String?
  startupInfo StartupInfo?
  companyInfo CompanyInfo?

  @@map("User")
}

model StartupInfo {
  id                  Int                          @id @default(autoincrement())
  userId              Int                          @unique
  foundedYear         Int?
  industry            IndustryType?
  technologies        TechnologyType[]             @default([])
  pitchDeck           String?
  demoVideo           String?
  monthlyUsersAverage Int?
  revenue             String?
  teamSize            Int?
  visible             Boolean                      @default(false)
  github              String?
  instagram           String?
  linkedin            String?
  facebook            String?
  contactEmail        String?
  embedding           Unsupported("vector(1024)")?
  user                User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  members             Member[]

  @@map("StartupInfo")
}

model Member {
  id            Int         @id @default(autoincrement())
  startupInfoId Int
  name          String
  age           Int
  position      String
  profileImage  String?
  university    String
  startupInfo   StartupInfo @relation(fields: [startupInfoId], references: [id], onDelete: Cascade)

  @@map("Member")
}

model CompanyInfo {
  id                   Int           @id @default(autoincrement())
  userId               Int           @unique
  industry             IndustryType?
  size                 Int?
  companyType          CompanyType?
  plan                 Plan          @default(FREE)
  planStatus           PlanStatus    @default(INACTIVE)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  searchesUsed         Int           @default(0)
  searchesRemaining    Int           @default(3)
  lastSearchReset      DateTime      @default(now())
  planCancelledAt      DateTime?
  planExpiresAt        DateTime?
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("CompanyInfo")
}

model StripeWebhookEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())

  @@index([type])
  @@map("StripeWebhookEvent")
}
